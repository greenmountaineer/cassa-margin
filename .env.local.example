# Supabase — get these from supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix with NEXT_PUBLIC_. Bypasses row-level security.
# Used by scripts/backup.mjs and the weekly digest cron job.
# Get from Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Retention email (Resend). Get the API key from resend.com after signup.
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random string that protects /api/cron/weekly-digest from being triggered
# by anyone who finds the URL. Generate with: openssl rand -hex 24
CRON_SECRET=your-random-secret
